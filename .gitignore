# ============================================================
# BLACK BEACON - Unreal Engine 5 project ignore rules
# ============================================================

# --- Unreal Engine generated / build artifacts ---
Binaries/
Intermediate/
DerivedDataCache/
Saved/
Build/
Plugins/*/Binaries/
Plugins/*/Intermediate/

# --- IDE / tooling ---
.vscode/
.idea/
.vs/
*.sln
*.suo
*.user
*.userprefs
*.swp
*~

# --- OS noise ---
.DS_Store
Thumbs.db

# --- Local-only files that must never be committed ---
*.log
LocalState/
*.orig
/Debug_Manual/
/Manual_Visuals/
/Content/BlackBeacon/Materials/M_BeamVolume.uasset

# --- Standalone test/tool build output ---
Tests/build/

# --- Misc ---
*.pdb
*.ilk

# Python source generators
__pycache__/
*.pyc

# Distribution binaries are GitHub Release assets, never Git source files.
/dist/
